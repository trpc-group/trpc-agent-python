# Agent model
TRPC_AGENT_API_KEY=your-agent-model-api-key
TRPC_AGENT_BASE_URL=https://your-agent-model-endpoint/v1
TRPC_AGENT_MODEL_NAME=your-agent-model

# Hy-Memory extraction model (OpenAI-compatible)
MEMORY_MODE=pro
# Reuse the Agent model. Replace these values when Memory uses another model.
MEMORY_LLM_API_KEY=${TRPC_AGENT_API_KEY}
MEMORY_LLM_BASE_URL=${TRPC_AGENT_BASE_URL}
MEMORY_LLM_MODEL=${TRPC_AGENT_MODEL_NAME}

# Custom remote BGE-M3 embedding service
BGE_M3_EMBEDDING_ENDPOINT=http://aigc_component.woa.com/embeddings/bge/embeddings/batch
X_CLIENT_SSID=your-client-ssid
X_HOST_KEY_ACCESS=your-host-key-access
MEMORY_EMBEDDING_DIMS=1024
# Optional request controls:
# BGE_M3_MAX_RETRIES=2
# BGE_M3_RETRY_DELAY=2
# BGE_M3_TIMEOUT=60

# Adapter routing. Use chat for this example.
HY_MEMORY_SCENE=chat
# Leave unset to generate a fresh user on each run. Set a fixed value to test
# persistence across separate process runs.
# HY_MEMORY_DEMO_USER_ID=demo-user
# Required only for working/coding isolation:
# HY_MEMORY_WORKSPACE_ID=github.com/example/service
# HY_MEMORY_BRANCH=main
