# 示例 Agent 使用的 LLM，与 Memory 实例凭证无关
TRPC_AGENT_API_KEY=sk-******************
TRPC_AGENT_BASE_URL=http://******************
TRPC_AGENT_MODEL_NAME=******************

# 腾讯云控制台提供的完整 Gateway 地址，必须包含 https://
TENCENTDB_MEMORY_ENDPOINT=https://******************

# 腾讯云控制台提供的 Gateway API Key，不是 sk-mem-* User Key
TENCENTDB_MEMORY_API_KEY=******************

# 腾讯云 Memory 实例 ID，例如 mem-xxxxxxxx
TENCENTDB_MEMORY_SERVICE_ID=mem-*******

# 在该实例中创建的真实 Team 和 Agent ID
TENCENTDB_MEMORY_TEAM_ID=team-*******
TENCENTDB_MEMORY_AGENT_ID=agt-*******

TENCENTDB_MEMORY_PIPELINE_WAIT_SECONDS=15
