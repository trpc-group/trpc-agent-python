# LLM configuration
TRPC_AGENT_API_KEY=your-llm-api-key
TRPC_AGENT_BASE_URL=https://your-llm-endpoint
TRPC_AGENT_MODEL_NAME=your-model-name

# TencentDB Agent Memory V3 gateway
TENCENTDB_MEMORY_ENDPOINT=http://127.0.0.1:8420
TENCENTDB_MEMORY_API_KEY=local
TENCENTDB_MEMORY_SERVICE_ID=your-memory-service-id
TENCENTDB_MEMORY_TEAM_ID=your-team-id
TENCENTDB_MEMORY_AGENT_ID=weather-assistant

# L1 extraction is asynchronous. Increase this for slower deployments.
TENCENTDB_MEMORY_PIPELINE_WAIT_SECONDS=5
MEMORY_PROMPT_MODE=chat
