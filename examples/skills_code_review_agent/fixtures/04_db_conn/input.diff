+"""Well-behaved sqlite3 usage: every path closes, commits or hands off ownership."""
+
+import contextlib
+import sqlite3
+
+
+def fetch_totals(path):
+    """Read-only query fully managed by context managers."""
+    with sqlite3.connect(path) as conn:
+        with contextlib.closing(conn.cursor()) as cur:
+            cur.execute("SELECT total FROM orders")
+            return cur.fetchall()
+
+
+def record_payment(path, amount):
+    """Write path with an explicit commit and a close in finally."""
+    conn = sqlite3.connect(path)
+    try:
+        conn.execute("INSERT INTO payments(amount) VALUES (?)", (amount,))
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def open_shared_connection(path):
+    """The caller takes ownership of the returned connection and closes it."""
+    conn = sqlite3.connect(path)
+    conn.execute("PRAGMA foreign_keys = ON")
+    return conn
