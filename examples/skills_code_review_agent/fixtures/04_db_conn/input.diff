+"""Small sqlite3 helpers for the demo order service."""
+
+import sqlite3
+
+
+def save_order(path, order_id, amount):
+    """Persist one order row; lifecycle handling is intentionally sloppy."""
+    conn = sqlite3.connect(path)
+    cur = conn.cursor()
+    cur.execute("INSERT INTO orders(id, amount) VALUES (?, ?)", (order_id, amount))
+    return cur.rowcount
