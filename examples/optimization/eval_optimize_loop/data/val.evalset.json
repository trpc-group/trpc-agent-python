        {
          "invocation_id": "v1",
          "user_content": {
            "parts": [{"text": "小轿车一共有 4 个轮子，5 辆小轿车一共有多少个轮子？"}],
            "role": "user"
          },
          "final_response": {
            "parts": [{"text": "步骤：4 × 5 = 20\n答案：20 个"}],
            "role": "model"
          }
        }
      ]
    },
    {
      "eval_id": "val_protected_highrisk",
      "session_input": {
        "app_name": "eval_optimize_loop",
